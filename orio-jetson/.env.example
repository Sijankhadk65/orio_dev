# Copy this file to .env and fill in your own values. .env is gitignored —
# never commit real keys.

# Required only when ORIO_LLM_PROVIDER=anthropic (the default). Get a key at
# https://console.anthropic.com.
ANTHROPIC_API_KEY=

# Required only when ORIO_TTS=elevenlabs. Get a key at https://elevenlabs.io.
ELEVENLABS_API_KEY=

# Optional overrides — uncomment to use.
# ORIO_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ORIO_ELEVENLABS_MODEL=eleven_turbo_v2_5
